# Zero-Copy Agent Environment Configuration Example
# Copy to .env and adjust if needed

# Server Settings
ZCA_HOST=127.0.0.1
ZCA_PORT=8000

# Optional Outbound Proxy (HTTP/HTTPS/SOCKS5)
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# Optional API Keys (also configurable via Web Dashboard http://127.0.0.1:8000)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Local Ollama URL
OLLAMA_HOST=http://127.0.0.1:11434
