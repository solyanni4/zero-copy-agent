{
  "manifest_version": 3,
  "name": "zero-copy-agent Chrome Bridge",
  "version": "1.6.0",
  "description": "Прямой WebSocket-драйвер и фоновая синхронизация веб-сессий для zero-copy-agent",
  "permissions": [
    "tabs",
    "scripting",
    "cookies",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*",
    "https://grok.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://grok.com/*"
      ],
      "js": ["content_bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZCA Chrome Bridge"
  },
  "icons": {
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "defaults.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
