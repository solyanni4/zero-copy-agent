{
  "manifest_version": 3,
  "name": "zero-copy-agent Cookie Sync",
  "version": "1.6.0",
  "description": "Автоматическая фоновая синхронизация авторизационных кук для zero-copy-agent",
  "permissions": [
    "cookies",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://chat.qwen.ai/*",
    "https://grok.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZCA Cookie Sync"
  },
  "icons": {
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "defaults.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
